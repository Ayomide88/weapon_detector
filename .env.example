# Environment variable overrides (copy to .env and fill in).
# These take precedence over configs/config.yaml. Never commit a real .env.

# --- Model / video ---
# WD_MODEL_WEIGHTS=models/best.pt
# WD_DEVICE=cpu
# WD_CONFIDENCE_THRESHOLD=0.6
# WD_VIDEO_SOURCE=0
# WD_VIDEO_SOURCE=rtsp://user:pass@192.168.1.10:554/stream1

# --- Twilio SMS alerts ---
# WD_TWILIO_ENABLED=true
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15005550006
# TWILIO_TO_NUMBER=+1234567890

# --- Email (SMTP) alerts ---
# WD_EMAIL_ENABLED=true
# WD_SMTP_HOST=smtp.gmail.com
# WD_SMTP_PORT=587
# WD_SMTP_USERNAME=alerts@example.com
# WD_SMTP_PASSWORD=app_password
# WD_EMAIL_FROM=alerts@example.com
# WD_EMAIL_TO=guard1@example.com,guard2@example.com
